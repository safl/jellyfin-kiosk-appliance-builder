xset s off
xset -dpms
xset s noblank
unclutter --timeout 1 --jitter 4 &
pkill -9 -f jkab-cec-bridge 2>/dev/null
sleep 1
python3 /home/jkab/bin/jkab-cec-bridge.py &

# Wait for jkab-server to be ready before launching player
for i in $(seq 1 30); do
    curl -sf http://localhost:8080/api/health >/dev/null 2>&1 && break
    sleep 1
done

while true; do
    python3 /home/jkab/bin/jkab-player.py
    sleep 1
done
