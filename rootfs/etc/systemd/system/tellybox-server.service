[Unit]
Description=Tellybox Media Server
Documentation=https://github.com/safl/tellybox
# The server binds to 127.0.0.1 only — no need to wait for NetworkManager
# to declare network-online before starting. Earlier start = faster boot.

[Service]
Type=simple
User=tellybox
Group=tellybox
ExecStart=/usr/bin/python3 /usr/local/bin/tellybox-server.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tellybox-server

[Install]
WantedBy=multi-user.target
